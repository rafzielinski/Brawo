<div class="d-flex flex-column flex-shrink-0 brawo-admin-sidebar">
  <ul class="nav nav-pills flex-column mb-auto">
    <li class="nav-item">
      <%= link_to t('brawo.sidebar.dashboard'), admin_root_path, class: "nav-link" %>
    </li>
    
    <li class="mt-3">
      <strong class="text-muted small sidebar-section-label"><%= t('brawo.sidebar.content_types') %></strong>
    </li>
    
    <% @content_types.each do |name, config| %>
      <li class="nav-item">
        <%= link_to config[:label], admin_contents_path(content_type: name), class: "nav-link" %>
      </li>
    <% end %>

    <% if @taxonomy_types.present? %>
      <li class="mt-3">
        <strong class="text-muted small sidebar-section-label"><%= t('brawo.sidebar.taxonomies') %></strong>
      </li>
      
      <% @taxonomy_types.each do |name, config| %>
        <li class="nav-item">
          <%= link_to config[:label], admin_taxonomies_path(taxonomy_type: name), class: "nav-link" %>
        </li>
      <% end %>
    <% end %>
  </ul>
</div>
