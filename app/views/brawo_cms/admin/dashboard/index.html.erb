<%= render 'brawo_cms/admin/shared/page_header',
           title: t('brawo.dashboard.title') %>

<p class="brawo-lead text-muted mb-4"><%= t('brawo.dashboard.welcome_body') %></p>

<div class="row g-3">
  <% @content_types.each do |name, config| %>
    <div class="col-md-4">
      <div class="card h-100">
        <div class="card-body d-flex flex-column">
          <h5 class="card-title mb-1"><%= config[:label].pluralize %></h5>
          <p class="card-text text-muted flex-grow-1"><%= t('brawo.dashboard.manage_content', label: config[:label].downcase) %></p>
          <div class="d-flex flex-wrap gap-2">
            <%= link_to t('brawo.dashboard.view_all'), admin_contents_path(content_type: name), class: "btn btn-outline-secondary btn-sm" %>
            <%= link_to t('brawo.dashboard.create_new'), new_admin_content_path(content_type: name), class: "btn btn-primary btn-sm" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<% if @content_types.empty? %>
  <div class="alert alert-warning mt-4" role="alert">
    <h5 class="alert-heading mb-2"><%= t('brawo.dashboard.no_content_types_heading') %></h5>
    <p class="mb-2"><%= t('brawo.dashboard.no_content_types_body_html',
          content_class: tag.code('BrawoCms::Content'),
          content_typeable_module: tag.code('BrawoCms::ContentTypeable')).html_safe %></p>
    <pre class="mb-0"><%= t('brawo.dashboard.no_content_types_example') %></pre>
  </div>
<% end %>
