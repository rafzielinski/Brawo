<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2"><%= @taxonomy_type_config[:label].pluralize %></h1>
  <div class="btn-toolbar mb-2 mb-md-0">
    <%= link_to t('brawo.actions.new', label: @taxonomy_type_config[:label]), 
                new_admin_taxonomy_path(taxonomy_type: @taxonomy_type), 
                class: "btn btn-primary" %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th><%= t('brawo.tables.name') %></th>
        <th><%= t('brawo.tables.slug') %></th>
        <th><%= t('brawo.tables.created') %></th>
        <th><%= t('brawo.tables.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @taxonomies.each do |taxonomy| %>
        <tr>
          <td><%= taxonomy.name %></td>
          <td><code><%= taxonomy.slug %></code></td>
          <td><%= brawo_format_date(taxonomy.created_at) %></td>
          <td>
            <div class="table-actions">
              <%= link_to t('brawo.actions.view'), admin_taxonomy_path(taxonomy, taxonomy_type: @taxonomy_type), class: "btn btn-sm btn-outline-dark" %>
              <%= link_to t('brawo.actions.edit'), edit_admin_taxonomy_path(taxonomy, taxonomy_type: @taxonomy_type), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to t('brawo.actions.delete'), admin_taxonomy_path(taxonomy, taxonomy_type: @taxonomy_type),
                          method: :delete,
                          data: { confirm: t('brawo.actions.confirm_delete') },
                          class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @taxonomies.empty? %>
  <div class="alert alert-info">
    <%= t('brawo.taxonomies.empty', label: @taxonomy_type_config[:label].pluralize.downcase) %>
    <%= link_to t('brawo.taxonomies.create_first', label: @taxonomy_type_config[:label].downcase), 
                new_admin_taxonomy_path(taxonomy_type: @taxonomy_type) %>
  </div>
<% end %>
