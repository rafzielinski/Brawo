<%= render 'brawo_cms/admin/shared/page_header',
           title: @taxonomy.name,
           toolbar: safe_join([
             link_to(t('brawo.actions.edit'), edit_admin_taxonomy_path(@taxonomy, taxonomy_type: @taxonomy_type), class: "btn btn-primary"),
             link_to(t('brawo.actions.back_to_list'), admin_taxonomies_path(taxonomy_type: @taxonomy_type), class: "btn btn-outline-secondary")
           ]) %>

<div class="card">
  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-6">
        <strong><%= t('brawo.attributes.name') %>:</strong> <%= @taxonomy.name %>
      </div>
      <div class="col-md-6">
        <strong><%= t('brawo.attributes.slug') %>:</strong> <code><%= @taxonomy.slug %></code>
      </div>
    </div>

    <% if @taxonomy.description.present? %>
      <div class="row mb-3">
        <div class="col-12">
          <strong><%= t('brawo.attributes.description') %>:</strong>
          <p><%= @taxonomy.description %></p>
        </div>
      </div>
    <% end %>

    <% if @taxonomy_type_config[:fields].present? %>
      <h5 class="mt-4 mb-3"><%= t('brawo.sections.custom_fields') %></h5>
      
      <% @taxonomy_type_config[:fields].each do |field| %>
        <div class="row mb-3">
          <div class="col-md-3">
            <strong><%= field[:label] || field[:name].to_s.titleize %>:</strong>
          </div>
          <div class="col-md-9">
            <%= display_field_value(@taxonomy, field) %>
          </div>
        </div>
      <% end %>
    <% end %>

    <div class="row mt-4">
      <div class="col-md-6">
        <small class="text-muted"><%= t('brawo.timestamps.created', datetime: brawo_format_datetime(@taxonomy.created_at)) %></small>
      </div>
      <div class="col-md-6 text-end">
        <small class="text-muted"><%= t('brawo.timestamps.updated', datetime: brawo_format_datetime(@taxonomy.updated_at)) %></small>
      </div>
    </div>
  </div>
</div>
