<%= form_with(model: taxonomy, 
              url: taxonomy.persisted? ? admin_taxonomy_path(taxonomy, taxonomy_type: @taxonomy_type) : admin_taxonomies_path(taxonomy_type: @taxonomy_type), 
              scope: :taxonomy,
              local: true) do |form| %>
  <% if taxonomy.errors.any? %>
    <%= render 'brawo_cms/admin/shared/form_errors',
               record: taxonomy,
               error_heading: t('brawo.taxonomies.errors.prohibited', count: taxonomy.errors.count) %>
  <% end %>

  <div class="mb-3">
    <%= form.label :name, t('brawo.attributes.name'), class: "form-label" %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form.label :slug, t('brawo.attributes.slug'), class: "form-label" %>
    <%= form.text_field :slug, class: "form-control" %>
    <small class="form-text text-muted"><%= t('brawo.hints.slug_from_name') %></small>
  </div>

  <div class="mb-3">
    <%= form.label :description, t('brawo.attributes.description'), class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <% if @taxonomy_type_config[:fields].present? %>
    <hr class="my-4">
    <h5 class="mb-3"><%= t('brawo.sections.custom_fields') %></h5>

    <%= render_field_group(form, @taxonomy_type_config[:fields], taxonomy, render_input: :render_field_input) %>
  <% end %>

  <div class="d-flex justify-content-between mt-4">
    <%= form.submit t('brawo.actions.submit'), class: "btn btn-primary" %>
    <%= link_to t('brawo.actions.cancel'), admin_taxonomies_path(taxonomy_type: @taxonomy_type), class: "btn btn-secondary" %>
  </div>
<% end %>
