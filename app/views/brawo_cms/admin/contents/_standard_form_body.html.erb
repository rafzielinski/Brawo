<div class="mb-3">
  <%= form.label :description, t('brawo.attributes.description'), class: "form-label" %>
  <%= form.text_area :description, class: "form-control", rows: 3 %>
</div>

<div class="mb-3">
  <%= form.label :status, t('brawo.attributes.status'), class: "form-label" %>
  <%= form.select :status, brawo_status_options, {}, class: "form-select" %>
</div>

<hr class="my-4">
<h5 class="mb-3"><%= t('brawo.sections.custom_fields') %></h5>

<%= render_field_group(form, @content_type_config[:fields], content, render_input: :render_field_input) %>

<% unless content.persisted? %>
  <div class="brawo-form-actions">
    <%= form.submit t('brawo.actions.submit'), class: "btn btn-primary" %>
  </div>
<% end %>
