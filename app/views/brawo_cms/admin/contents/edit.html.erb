<%= render 'brawo_cms/admin/shared/page_header',
           title: t('brawo.contents.edit_title', label: @content_type_config[:label]),
           heading_class: 'brawo-page-heading' %>

<% if @content_type_config[:page_builder] %>
  <%= render 'page_builder_form', content: @content %>
<% else %>
  <%= render 'form', content: @content %>
<% end %>
