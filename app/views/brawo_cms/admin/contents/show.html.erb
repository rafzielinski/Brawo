<%= render 'brawo_cms/admin/shared/page_header',
           title: @content.title,
           toolbar: safe_join([
             link_to(t('brawo.actions.edit'), edit_admin_content_path(@content, content_type: @content_type), class: "btn btn-primary"),
             link_to(t('brawo.actions.back_to_list'), admin_contents_path(content_type: @content_type), class: "btn btn-outline-secondary")
           ]) %>

<div class="card">
  <div class="card-body">
    <div class="row mb-3">
      <div class="col-md-6">
        <strong><%= t('brawo.attributes.status') %>:</strong>
        <%= render 'brawo_cms/admin/shared/status_badge', status: @content.status %>
      </div>
      <div class="col-md-6">
        <strong><%= t('brawo.attributes.slug') %>:</strong> <%= @content.slug %>
      </div>
    </div>

    <% if @content.description.present? %>
      <div class="row mb-3">
        <div class="col-12">
          <strong><%= t('brawo.attributes.description') %>:</strong>
          <p><%= @content.description %></p>
        </div>
      </div>
    <% end %>

    <h5 class="mt-4 mb-3"><%= t('brawo.sections.custom_fields') %></h5>
    
    <% @content_type_config[:fields].each do |field| %>
      <div class="row mb-3">
        <div class="col-md-3">
          <strong><%= field[:label] || field[:name].to_s.titleize %>:</strong>
        </div>
        <div class="col-md-9">
          <%= display_field_value(@content, field) %>
        </div>
      </div>
    <% end %>

    <div class="row mt-4">
      <div class="col-md-6">
        <small class="text-muted"><%= t('brawo.timestamps.created', datetime: brawo_format_datetime(@content.created_at)) %></small>
      </div>
      <div class="col-md-6 text-end">
        <small class="text-muted"><%= t('brawo.timestamps.updated', datetime: brawo_format_datetime(@content.updated_at)) %></small>
      </div>
    </div>
  </div>
</div>
