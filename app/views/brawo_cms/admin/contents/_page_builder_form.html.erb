<%= form_with(model: content,
              url: content.persisted? ? admin_content_path(content, content_type: @content_type) : admin_contents_path(content_type: @content_type),
              scope: :content,
              local: true) do |form| %>
  <% if content.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= t('brawo.contents.errors.prohibited', count: content.errors.count) %></h4>
      <ul>
        <% content.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row mb-4">
    <div class="col-md-4">
      <%= form.label :title, t('brawo.attributes.title'), class: "form-label" %>
      <%= form.text_field :title, class: "form-control", required: true %>
    </div>
    <div class="col-md-4">
      <%= form.label :slug, t('brawo.attributes.slug'), class: "form-label" %>
      <%= form.text_field :slug, class: "form-control" %>
      <small class="form-text text-muted"><%= t('brawo.hints.slug_from_title') %></small>
    </div>
    <div class="col-md-4">
      <%= form.label :status, t('brawo.attributes.status'), class: "form-label" %>
      <%= form.select :status, brawo_status_options, {}, class: "form-select" %>
    </div>
  </div>

  <div class="mb-3">
    <%= form.label :description, t('brawo.attributes.description'), class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 2 %>
  </div>

  <% @content_type_config[:fields].each do |field| %>
  <% if field[:type] == :blocks %>
    <%= render_field_input(form, field, content) %>
  <% end %>
  <% end %>

  <div class="d-flex justify-content-between mt-4">
    <%= form.submit t('brawo.actions.submit'), class: "btn btn-primary" %>
    <%= link_to t('brawo.actions.cancel'), admin_contents_path(content_type: @content_type), class: "btn btn-secondary" %>
  </div>
<% end %>
