<%= form_with(model: content,
              url: content.persisted? ? admin_content_path(content, content_type: @content_type) : admin_contents_path(content_type: @content_type),
              scope: :content,
              local: true,
              html: { id: (content.persisted? ? "brawo-content-form" : nil), data: { slug_conflict_form: true } }) do |form| %>
  <% if content.new_record? %>
    <%= hidden_field_tag :accept_adjusted_slug, "0", id: "accept_adjusted_slug" %>
  <% end %>
  <% if content.errors.any? %>
    <%= render 'brawo_cms/admin/shared/form_errors',
               record: content,
               error_heading: t('brawo.contents.errors.prohibited', count: content.errors.count) %>
  <% end %>

  <% if content.persisted? %>
    <div class="content-meta-panel">
      <%= render 'title_slug_fields', form: form, content: content %>
    </div>

    <div class="card">
      <div class="card-body">
        <%= render 'page_builder_form_body', form: form, content: content %>
      </div>
    </div>
  <% else %>
    <%= render 'title_slug_fields', form: form, content: content %>
    <%= render 'page_builder_form_body', form: form, content: content %>
  <% end %>
<% end %>
