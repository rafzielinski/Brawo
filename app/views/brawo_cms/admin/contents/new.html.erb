<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2">New <%= @content_type_config[:label] %></h1>
</div>

<div class="card">
  <div class="card-body">
    <% if @content_type_config[:page_builder] %>
      <%= render 'page_builder_form', content: @content %>
    <% else %>
      <%= render 'form', content: @content %>
    <% end %>
  </div>
</div>

