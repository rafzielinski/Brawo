<%= render 'brawo_cms/admin/shared/page_header',
           title: @content_type_config[:label].pluralize,
           toolbar: link_to(t('brawo.actions.new', label: @content_type_config[:label]),
                            new_admin_content_path(content_type: @content_type),
                            class: "btn btn-primary") %>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th><%= t('brawo.tables.title') %></th>
        <th><%= t('brawo.tables.status') %></th>
        <th><%= t('brawo.tables.created') %></th>
        <th class="brawo-table__actions"><%= t('brawo.tables.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @contents.each do |content| %>
        <tr>
          <td><%= content.title %></td>
          <td>
            <%= render 'brawo_cms/admin/shared/status_badge', status: content.status %>
          </td>
          <td><%= brawo_format_date(content.created_at) %></td>
          <td class="brawo-table__actions">
            <div class="table-actions">
              <%= link_to t('brawo.actions.view'), admin_content_path(content, content_type: @content_type), class: "btn btn-sm btn-outline-secondary" %>
              <%= link_to t('brawo.actions.edit'), edit_admin_content_path(content, content_type: @content_type), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to t('brawo.actions.delete'), admin_content_path(content, content_type: @content_type),
                          data: { turbo_method: :delete, turbo_confirm: t('brawo.actions.confirm_delete') },
                          class: "btn btn-sm btn-outline-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @contents.empty? %>
  <p class="brawo-empty-state text-muted">
    <%= t('brawo.contents.empty', label: @content_type_config[:label].pluralize.downcase) %>
    <%= link_to t('brawo.contents.create_first', label: @content_type_config[:label].downcase),
                new_admin_content_path(content_type: @content_type) %>
  </p>
<% end %>
