<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
  <h1 class="h2"><%= @content_type_config[:label].pluralize %></h1>
  <div class="btn-toolbar mb-2 mb-md-0">
    <%= link_to t('brawo.actions.new', label: @content_type_config[:label]), 
                new_admin_content_path(content_type: @content_type), 
                class: "btn btn-primary" %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th><%= t('brawo.tables.title') %></th>
        <th><%= t('brawo.tables.status') %></th>
        <th><%= t('brawo.tables.created') %></th>
        <th><%= t('brawo.tables.actions') %></th>
      </tr>
    </thead>
    <tbody>
      <% @contents.each do |content| %>
        <tr>
          <td><%= content.title %></td>
          <td>
            <span class="badge <%= status_badge_class(content.status) %>">
              <%= brawo_status_label(content.status) %>
            </span>
          </td>
          <td><%= brawo_format_date(content.created_at) %></td>
          <td>
            <div class="table-actions">
              <%= link_to t('brawo.actions.view'), admin_content_path(content, content_type: @content_type), class: "btn btn-sm btn-outline-dark" %>
              <%= link_to t('brawo.actions.edit'), edit_admin_content_path(content, content_type: @content_type), class: "btn btn-sm btn-outline-primary" %>
              <%= link_to t('brawo.actions.delete'), admin_content_path(content, content_type: @content_type),
                          method: :delete,
                          data: { confirm: t('brawo.actions.confirm_delete') },
                          class: "btn btn-sm btn-danger" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% if @contents.empty? %>
  <div class="alert alert-info">
    <%= t('brawo.contents.empty', label: @content_type_config[:label].pluralize.downcase) %>
    <%= link_to t('brawo.contents.create_first', label: @content_type_config[:label].downcase), 
                new_admin_content_path(content_type: @content_type) %>
  </div>
<% end %>
