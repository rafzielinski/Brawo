<%= render "brawo_cms/admin/shared/page_header",
           title: @media.display_title,
           heading_class: "brawo-page-heading",
           toolbar: safe_join([
             link_to(t("brawo.actions.edit"), edit_admin_medium_path(@media), class: "btn btn-outline-primary btn-sm"),
             link_to(t("brawo.actions.back_to_list"), admin_media_path, class: "btn btn-outline-secondary btn-sm")
           ], " ") %>

<div class="card">
  <div class="card-body">
  <% if @media.file.attached? %>
    <div class="brawo-media-detail__preview mb-4">
      <% if @media.image? %>
          <%= image_tag brawo_media_image_url(@media, variant: :original), class: "brawo-media-detail__image", alt: @media.alt_text %>
      <% else %>
        <div class="brawo-media-card__file-icon brawo-media-detail__file-icon">
          <i class="bi bi-file-earmark" aria-hidden="true"></i>
        </div>
      <% end %>
    </div>
    <dl class="row mb-0">
      <dt class="col-sm-3"><%= t("brawo.media.filename") %></dt>
      <dd class="col-sm-9"><code><%= @media.filename %></code></dd>
      <dt class="col-sm-3"><%= t("brawo.media.content_type") %></dt>
      <dd class="col-sm-9"><%= @media.content_type %></dd>
      <dt class="col-sm-3"><%= t("brawo.attributes.title") %></dt>
      <dd class="col-sm-9"><%= @media.title.presence || t("brawo.fields.empty_value") %></dd>
      <dt class="col-sm-3"><%= t("brawo.media.alt_text") %></dt>
      <dd class="col-sm-9"><%= @media.alt_text.presence || t("brawo.fields.empty_value") %></dd>
    </dl>
  <% end %>
  </div>
</div>
