<%= form_with url: media.persisted? ? admin_medium_path(media) : admin_media_path,
              scope: :media,
              method: media.persisted? ? :patch : :post,
              local: true,
              html: { class: "brawo-media-form" } do |form| %>
  <%= render "brawo_cms/admin/shared/form_errors",
             record: media,
             error_heading: t("brawo.media.errors.prohibited", count: media.errors.count) %>

  <% unless media.persisted? %>
    <div class="mb-3">
      <%= form.label :file, t("brawo.media.file"), class: "form-label" %>
      <%= form.file_field :file, class: "form-control", required: true, accept: "image/*,application/pdf" %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, t("brawo.attributes.title"), class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :alt_text, t("brawo.media.alt_text"), class: "form-label" %>
    <%= form.text_field :alt_text, class: "form-control" %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit submit_label, class: "btn btn-primary" %>
    <% if media.persisted? %>
      <%= link_to t("brawo.actions.delete"), admin_medium_path(media),
                  data: { turbo_method: :delete, turbo_confirm: t("brawo.actions.confirm_delete") },
                  class: "btn btn-outline-danger" %>
    <% end %>
  </div>
<% end %>
